# --- Infrastructure (docker compose up -d) ---
DATABASE_URL=postgresql://sp:sp@localhost:5432/socialpilot
REDIS_URL=redis://localhost:6379

# --- Security ---
# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# Any long random string (same command works)
SESSION_SECRET=

# --- App ---
WEB_ORIGIN=http://localhost:5173
API_PORT=4000
STORAGE_DIR=./storage

# --- Owner account created by `pnpm db:seed` ---
OWNER_EMAIL=
OWNER_PASSWORD=

# --- Bootstrap AI providers (optional; prefer Settings -> AI Providers in the app) ---
# Comma-separated lists. Used only when no provider is configured in the database.
AI_PROVIDER_ORDER=nvidia,ollama
NVIDIA_API_KEYS=
NVIDIA_MODELS=
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_API_KEYS=
OLLAMA_MODELS=
