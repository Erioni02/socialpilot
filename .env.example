# ───────────── Core ─────────────
NODE_ENV=development
# Local dev without Docker: `pnpm db:start` runs PostgreSQL on 5433. Docker Compose uses postgres:5432.
DATABASE_URL=postgresql://socialpilot:socialpilot@localhost:5433/socialpilot
# Optional. When set, BullMQ dispatches background jobs through Redis; otherwise a Postgres-backed queue is used.
REDIS_URL=

API_PORT=4000
# Browser URL of the web app (OAuth flows return here)
APP_URL=http://localhost:5173
# URL where OAuth providers can reach the API (callback URLs are ${API_PUBLIC_URL}/api/oauth/<provider>/callback)
API_PUBLIC_URL=http://localhost:4000
# Public HTTPS URL that Instagram/TikTok can download media from (e.g. your deployed API or a tunnel). Required for IG/TikTok publishing.
PUBLIC_BASE_URL=

# 32 random bytes, base64. Generate with: pnpm gen:key
ENCRYPTION_KEY=
SESSION_SECRET=
ALLOW_REGISTRATION=true

STORAGE_DIR=.data/storage
MAX_UPLOAD_MB=200
WORKER_CONCURRENCY=4
# Optional explicit paths if ffmpeg/ffprobe are not on PATH
FFMPEG_PATH=
FFPROBE_PATH=

# ───────────── AI providers (optional; can also be added per user in Settings → AI providers) ─────────────
# NVIDIA API Catalog (build.nvidia.com) — main AI, reasoning, vision and fast models (key starts with nvapi-)
NVIDIA_API_KEY=
# Cloudflare Workers AI — image generation (token needs the "Workers AI" permission) + your account ID
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# ByteDance Seedance via BytePlus ModelArk — video generation. Override the base URL for Volcengine (China): https://ark.cn-beijing.volces.com/api/v3
BYTEPLUS_API_KEY=
BYTEPLUS_BASE_URL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
REPLICATE_API_TOKEN=
STABILITY_API_KEY=

# ───────────── Data sources (optional) ─────────────
# Apify — paid, opt-in only: website traffic estimates (~$0.16/domain) and optional Instagram/TikTok scrapes. Every run needs confirmation and has a spend cap.
APIFY_API_TOKEN=
NEWSAPI_KEY=
PRODUCTHUNT_TOKEN=
PAGESPEED_API_KEY=
GITHUB_PUBLIC_TOKEN=

# ───────────── OAuth developer apps (optional; can also be entered in Settings → Developer apps) ─────────────
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
