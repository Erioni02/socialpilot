# =====================================================================
# SocialPilot configuration. Copy to .env and fill in. Never commit .env.
# =====================================================================

# --- Database (PostgreSQL) ---
# Option A — Supabase (recommended): Project Settings -> Database -> Connection string.
#   DATABASE_URL = the "Session pooler" URI (port 5432)  e.g. postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#   DIRECT_URL   = the "Direct connection" URI, or the same session-pooler URI if your network has no IPv6
#   (Do not use the transaction pooler on port 6543: the job queue and live events need session features.)
# Option B — local, no Docker: run `npm run db:local` in its own terminal and keep these values.
DATABASE_URL=postgresql://sp:sp@localhost:5432/socialpilot
DIRECT_URL=postgresql://sp:sp@localhost:5432/socialpilot

# --- Supabase Storage (optional) ---
# When both are set, uploads (logos, later media) go to the Supabase Storage bucket below; otherwise to STORAGE_DIR on disk.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=socialpilot

# --- Security ---
# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# Any long random string (same command works)
SESSION_SECRET=

# --- App ---
WEB_ORIGIN=http://localhost:5173
API_PORT=4000
STORAGE_DIR=./storage

# --- Owner account created by `pnpm db:seed` ---
OWNER_EMAIL=
OWNER_PASSWORD=

# --- Bootstrap AI providers (optional; prefer Settings -> AI Providers in the app) ---
# Comma-separated lists. Used only when no provider is configured in the database.
AI_PROVIDER_ORDER=nvidia,ollama
NVIDIA_API_KEYS=
NVIDIA_MODELS=
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_API_KEYS=
OLLAMA_MODELS=
